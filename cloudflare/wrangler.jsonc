{
 "$schema":"../node_modules/wrangler/config-schema.json",
 "name":"four-plans",
 "main":"src/index.ts",
 "compatibility_date":"2026-10-13",
 "workers_dev":true,
 "assets":{"directory":"../web/dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "d1_databases":[{"binding":"DB","database_name":"four-plans","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
 "observability":{"enabled":true},
 "limits":{"cpu_ms":10}
}
